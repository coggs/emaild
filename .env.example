# ---- Oracle Database 26ai Free ----
# Password for SYS/SYSTEM/PDBADMIN (set on first DB start; used only by `emaild init-db`)
ORACLE_PWD=change-me-Str0ng
EMAILD_DB_DSN=localhost:1521/FREEPDB1
EMAILD_DB_OWNER_PASSWORD=change-me-0wner
EMAILD_DB_APP_PASSWORD=change-me-App1
EMAILD_DB_ADMIN_PASSWORD=change-me-Adm1n

# ---- Encryption ----
# Generate with:  python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Losing this key = losing access to stored tokens and raw mail. Back it up.
EMAILD_MASTER_KEY=

# ---- First tenant/user (created by init-db) ----
EMAILD_TENANT_NAME=household
EMAILD_DEFAULT_USER=you@example.com
EMAILD_DEFAULT_USER_NAME=Username

# ---- Gmail ----
EMAILD_GOOGLE_CLIENT_FILE=/run/emaild/google_client.json
EMAILD_PUBLIC_URL=http://localhost:8080
EMAILD_BACKFILL_DAYS=180
EMAILD_POLL_SECONDS=90

# ---- Outlook.com (Microsoft Graph, read-only: Mail.Read) ----
# App registration in the Azure portal (docs/SETUP.md, "Linking an Outlook.com account").
# Redirect URI to register: ${EMAILD_PUBLIC_URL}/oauth/microsoft/callback
# Application (client) ID from the app's Overview page (a GUID like 00000000-0000-0000-0000-000000000000)
EMAILD_MS_CLIENT_ID=
# Client secret VALUE (not its ID). Either set it here, or leave it empty and put it in secrets/ms_client_secret
# (mounted at /run/emaild/ms_client_secret). Secrets expire - note the date and rotate before it.
EMAILD_MS_CLIENT_SECRET=
# EMAILD_MS_CLIENT_SECRET_FILE=/run/emaild/ms_client_secret
# consumers = personal Microsoft accounts (outlook.com / hotmail.com / live.com)
EMAILD_MS_TENANT=consumers
# Work or school (Microsoft 365 / Entra ID) accounts, linked with "Link work or school account". organizations = any
# organisation's directory; or lock it to one directory with its tenant ID or a verified domain, e.g.
# EMAILD_MS_WORK_TENANT=<your-tenant-id>   or   EMAILD_MS_WORK_TENANT=contoso.example.com
# Needs the app registration's account types set to "any organizational directory and personal Microsoft accounts".
EMAILD_MS_WORK_TENANT=organizations

# ---- Embeddings (in-database ONNX) ----
EMAILD_EMBED_MODEL=ALL_MINILM_L12_V2
EMAILD_EMBED_FILE=all_MiniLM_L12_v2.onnx
EMAILD_EMBED_BATCH=200

# ---- LLM ----
# Ollama as seen from WSL (verified: localhost:11434). Check the exact tag with `ollama list`.
EMAILD_LLM_PROVIDER=ollama
EMAILD_OLLAMA_URL=http://localhost:11434
EMAILD_LLM_MODEL=gemma4:latest
EMAILD_LLM_NUM_CTX=16384
# Optional OpenAI-compatible provider (OCI GenAI, OpenAI, vLLM, LiteLLM...). Only used if the privacy policy allows.
EMAILD_OPENAI_BASE_URL=
EMAILD_OPENAI_API_KEY=
EMAILD_OPENAI_MODEL=
# local_only | cloud_allowed
EMAILD_PRIVACY_DEFAULT=local_only

# ---- Triage (Phase 1a, shadow mode: proposes, never acts) ----
# How far back to triage existing mail (new mail is always triaged)
EMAILD_TRIAGE_DAYS=14
# Max emails classified per worker cycle (keeps the loop responsive)
EMAILD_TRIAGE_PER_CYCLE=25
# Decisions below this confidence go to your review queue
EMAILD_REVIEW_THRESHOLD=0.75
# Share of confident decisions sent to review anyway (measures accuracy on easy cases; 0 to disable)
EMAILD_SPOT_CHECK_RATE=0.05
# Optional: a different Ollama model just for triage (defaults to EMAILD_LLM_MODEL)
EMAILD_TRIAGE_MODEL=

# ---- Morning brief + Telegram (Phase 1b/1c) ----
EMAILD_TZ=Australia/Sydney
EMAILD_BRIEF_TIME=08:00
EMAILD_BRIEF_DAYS=mon,tue,wed,thu,fri,sat,sun
# 1 = Gemma writes a 2-3 sentence overview at the top of the brief (from summaries only, never full emails)
EMAILD_BRIEF_LLM=1
# From @BotFather. Telegram chats are NOT end-to-end encrypted: emAIl sends summaries, never full emails.
EMAILD_TELEGRAM_TOKEN=
# Alerts inside this window wait until it ends (the brief still goes at EMAILD_BRIEF_TIME)
EMAILD_QUIET_HOURS=22:00-07:00

# ---- One-time codes / sign-in links ----
# Flagged on Telegram as they arrive (ignores quiet hours), hidden once expired, and scrubbed from emAIl's copy.
# Sending the code itself to Telegram weakens 2FA (Telegram isn't end-to-end encrypted) - off by default.
EMAILD_TELEGRAM_SHOW_CODES=0
# Expiry assumed when the email doesn't state one
EMAILD_CODE_DEFAULT_MINUTES=15
# Tip: lower EMAILD_POLL_SECONDS to 30 so codes reach you quickly

# ---- Network ----
# Address the web app and MCP server listen on. 127.0.0.1 = this PC only.
EMAILD_BIND_HOST=127.0.0.1
# Required before exposing the web app on your LAN (browser will prompt; any username)
EMAILD_WEB_PASSWORD=

# ---- MCP ----
# If set, HTTP MCP clients must send `Authorization: Bearer <token>`
EMAILD_MCP_TOKEN=
